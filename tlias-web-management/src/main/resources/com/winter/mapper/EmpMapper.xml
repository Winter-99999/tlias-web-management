<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.winter.mapper.EmpMapper">
    <!--列表与导出共用的筛选条件-->
    <sql id="empCommonWhere">
        <if test="name != null and name != ''">
            and e.name like CONCAT('%',#{name},'%')
        </if>
        <if test="gender != null">
            and e.gender = #{gender}
        </if>
        <if test="deptId != null">
            and e.dept_id = #{deptId}
        </if>
        <if test="begin != null and end != null">
            and e.entry_date between #{begin} and #{end}
        </if>
    </sql>
    <!--根据具体条件查询员工-->
    <select id="list" resultType="com.winter.pojo.Emp">
        select e.id,e.username,e.name,e.gender,e.phone,e.job,e.role,e.salary,e.image,
        e.entry_date,e.dept_id,e.create_time,e.update_time,
        d.name deptName
        from emp e
        left join dept d on e.dept_id = d.id
        <where>
            <include refid="empCommonWhere"/>
        </where>
        ORDER BY e.update_time desc
    </select>

    <!--删除员工-->
    <delete id="deleteByIds">
            delete from emp where id in
            <foreach collection="ids" item="id" separator="," open="(" close=")">
                #{id}
            </foreach>
    </delete>

    <!--查询返回的字段名与实体类属性对应不上 用resultMap封装信息-->
    <resultMap id="empResultMap" type="com.winter.pojo.Emp">
        <!--封装员工基本信息-->
        <id property="id" column="id"/>
        <result column="username" property="username"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="job" property="job"/>
        <result column="role" property="role"/>
        <result column="salary" property="salary"/>
        <result column="image" property="image"/>
        <result column="entry_date" property="entryDate"/>
        <result column="dept_id" property="deptId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <!--封装工作经历-->
        <collection property="exprList" ofType="com.winter.pojo.EmpExpr">
            <id column="ee_id" property="id"/>
            <result column="ee_empid" property="empId"/>
            <result column="ee_begin" property="begin"/>
            <result column="ee_end" property="end"/>
            <result column="ee_company" property="company"/>
            <result column="ee_job" property="job"/>
        </collection>
    </resultMap>
    <!--根据id查询员工信息-->
    <select id="getById" resultMap="empResultMap">
        select e.id,e.username,e.name,e.gender,e.phone,e.job,e.role,e.salary,e.image,
            e.entry_date,e.dept_id,e.create_time,e.update_time,
               ee.id ee_id,
               ee.emp_id ee_empid,
               ee.begin ee_begin,
               ee.end ee_end,
               ee.company ee_company,
               ee.job ee_job
               from emp e left join emp_expr ee on e.id = ee.emp_id
        where e.id = #{id}
    </select>
    <!--根据id修改员工信息-->
    <!--set标签 生成set关键字 自动删除多余的逗号-->
    <update id="update">
        UPDATE emp
        <set>

            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="job != null ">
                job = #{job},
            </if>
            <if test="role != null ">
                role = #{role},
            </if>
            <if test="salary != null">
                salary = #{salary},
            </if>
            <if test="image != null and image != ''">
                image = #{image},
            </if>
            <if test="entryDate != null ">
                entry_date = #{entryDate},
            </if>
            <if test="deptId != null ">
                dept_id = #{deptId},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime}
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!--统计员工职位-->
    <select id="getEmpCountJob">
        select (case job when '1' then '班主任'
            when '2' then '讲师'
            when '3' then '学工主管'
            when '4' then '教研主管'
            when '5' then '咨询师'
                else '其他' end ) as pos
             ,count(*) as num from emp group by job order by num
    </select>
    <!--统计员工性别-->
    <select id="getEmpCountGender">
        select if(gender='1','男','女') name,count(*) value from emp group by gender
    </select>

    <!--导出用：不分页，条件与列表一致-->
    <select id="exportList" resultType="com.winter.pojo.Emp">
        select e.id,e.username,e.name,e.gender,e.phone,e.job,e.role,e.salary,e.image,
        e.entry_date,e.dept_id,e.create_time,e.update_time,
        d.name deptName
        from emp e
        left join dept d on e.dept_id = d.id
        <where>
            <include refid="empCommonWhere"/>
        </where>
        order by e.id
    </select>

</mapper>
